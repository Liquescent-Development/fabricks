# Python Runtime Base Image
#
# This is an official Fabricks runtime image for Python applications.
# End users don't build this - they use it via [from].source = "python"
#
# To build this runtime (requires componentize-py):
#   fabricks build examples/runtimes/python --tag fabricks.dev/runtimes/python:3.12
#
# To use this runtime (no toolchain required):
#   [from]
#   source = "python"
#   version = "3.12"

fabrick_version = "1.0"

[info]
name = "python-runtime"
version = "3.12.0"
type = "http"
description = "Python 3.12 HTTP runtime for Fabricks - bundles CPython interpreter with WASI HTTP support"
authors = ["Fabricks Team"]
license = "Apache-2.0"

# Note: This runtime is built using componentize-py (no [from] section needed)
# The build command below handles everything


[build]
# The Python runtime uses componentize-py to bundle CPython + our HTTP framework
# This requires componentize-py to be installed: pip install componentize-py
# Use: mise exec -- uv run componentize-py ...
command = """
mise exec -- uv run componentize-py \
    --wit-path wit \
    --world http-handler \
    --world-module http_handler \
    componentize \
    -p src \
    handler \
    -o python-runtime.wasm
"""
output = "python-runtime.wasm"

[capabilities.network]
listen = [8080]
