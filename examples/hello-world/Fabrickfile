# Hello World Example
# The simplest possible Fabrickfile - a minimal CLI service

fabrick_version = "1.0"

[info]
name = "hello-world"
version = "0.1.0"
type = "cli"
description = "The simplest possible Fabricks service - prints a greeting and exits"

[from]
source = "rust"

[source]
path = "."

[build]
command = "cargo component build --release"
output = "target/wasm32-wasip1/release/hello_world.wasm"
