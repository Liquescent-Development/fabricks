# Rust HTTP Service Example
# An HTTP service built with Rust using wasi:http

fabrick_version = "1.0"

[info]
name = "rust-http"
version = "0.1.0"
type = "http"
description = "A simple Rust HTTP service using wasi:http"

[from]
source = "rust"

[source]
path = "."

[capabilities.network]
listen = [8888]

[health_check.http]
path = "/health"
