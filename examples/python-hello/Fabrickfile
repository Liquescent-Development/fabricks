# Python Hello World
#
# A simple Python HTTP service. Just write Python - Fabricks handles the rest.
#
# No need to know about WASM, componentize-py, or any other toolchain.
# Fabricks automatically builds your Python code into a WASM component.

fabrick_version = "1.0"

[info]
name = "python-hello"
version = "1.0.0"
type = "http"
description = "A simple Python HTTP service"

# Use the Python runtime - Fabricks handles the WASM build automatically
[from]
source = "python"
version = "3.12"

# Point to your Python code
[source]
path = "."
entrypoint = "app:handler"

# Network capabilities
[capabilities.network]
listen = [8080]
