# Product Service
# Product catalog management

fabrick_version = "1.0"

[info]
name = "product"
version = "1.0.0"
type = "http"
description = "Product catalog service"

[from]
source = "rust"

[source]
path = "."

[build]
command = "cargo component build --release"
output = "target/wasm32-wasip1/release/product.wasm"

[capabilities.network]
listen = [8081]

[health_check.http]
path = "/health"
port = 8081
interval = "30s"
