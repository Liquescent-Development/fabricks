# User Service
# User management

fabrick_version = "1.0"

[info]
name = "user"
version = "1.0.0"
type = "http"
description = "User management service"

[from]
source = "rust"

[source]
path = "."

[build]
command = "cargo component build --release"
output = "target/wasm32-wasip1/release/user.wasm"

[capabilities.network]
listen = [8084]

[health_check.http]
path = "/health"
port = 8084
interval = "30s"
