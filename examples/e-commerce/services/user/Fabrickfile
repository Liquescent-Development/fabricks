# User Service
# User management and authentication

fabrick_version = "1.0"

[info]
name = "user"
version = "1.0.0"
description = "User management service"

[from]
source = "rust"

[source]
path = "."

[build]
command = "cargo build --target wasm32-wasi --release"
output = "target/wasm32-wasi/release/user.wasm"

exports = ["get_user", "create_user", "authenticate", "update_profile"]

[capabilities]
env = ["DATABASE_URL", "LOG_LEVEL"]

[capabilities.network]
listen = [8084]
connect = ["postgres:5432"]

[health_check.http]
path = "/health"
port = 8084
interval = "30s"

[config.resources]
memory = "256Mi"
cpu = 0.5
