# Order Service
# Order processing and management

fabrick_version = "1.0"

[info]
name = "order"
version = "1.0.0"
type = "http"
description = "Order processing service"

[from]
source = "rust"

[source]
path = "."

[build]
command = "cargo component build --release"
output = "target/wasm32-wasip1/release/order.wasm"

[capabilities.network]
listen = [8083]

[health_check.http]
path = "/health"
port = 8083
interval = "30s"
