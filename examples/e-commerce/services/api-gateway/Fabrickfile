# API Gateway Service
# Entry point for the e-commerce platform

fabrick_version = "1.0"

[info]
name = "api-gateway"
version = "1.0.0"
type = "http"
description = "API gateway for e-commerce platform"

[from]
source = "rust"

[source]
path = "."

[build]
command = "cargo component build --release"
output = "target/wasm32-wasip1/release/api_gateway.wasm"

[capabilities.network]
listen = [8080]

[health_check.http]
path = "/health"
port = 8080
interval = "10s"
