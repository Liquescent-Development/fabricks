# Cart Service
# Shopping cart management

fabrick_version = "1.0"

[info]
name = "cart"
version = "1.0.0"
type = "http"
description = "Shopping cart service"

[from]
source = "rust"

[source]
path = "."

[build]
command = "cargo component build --release"
output = "target/wasm32-wasip1/release/cart.wasm"

[capabilities.network]
listen = [8082]

[health_check.http]
path = "/health"
port = 8082
interval = "30s"
