# API Service
# REST API for managing items

fabrick_version = "1.0"

[info]
name = "api"
version = "1.0.0"
description = "REST API for managing items"

[from]
source = "rust"

[source]
path = "."
include = ["src/**/*.rs", "Cargo.toml", "Cargo.lock"]

[build]
command = "cargo build --target wasm32-wasi --release"
output = "target/wasm32-wasi/release/api.wasm"
watch = ["src/**/*.rs", "Cargo.toml"]

[capabilities]
env = ["DATABASE_URL", "LOG_LEVEL"]

[capabilities.network]
listen = [8080]
connect = ["postgres:5432"]

[health_check.http]
path = "/health"
port = 8080
interval = "30s"
timeout = "5s"

[config]
port = 8080

[config.resources]
memory = "256Mi"
cpu = 0.5
