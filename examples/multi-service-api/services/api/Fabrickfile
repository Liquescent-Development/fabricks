# API Service
# REST API for managing items with in-memory storage

fabrick_version = "1.0"

[info]
name = "api"
version = "1.0.0"
type = "http"
description = "REST API for managing items"

[from]
source = "rust"

[source]
path = "."

[build]
command = "cargo component build --release"
output = "target/wasm32-wasip1/release/api.wasm"

[capabilities]
env = ["LOG_LEVEL"]

[capabilities.network]
listen = [8080]

[health_check.http]
path = "/health"
port = 8080
interval = "30s"
